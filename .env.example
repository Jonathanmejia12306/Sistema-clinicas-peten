# Configure one database backend. PostgreSQL takes precedence when set.
SQLITE_DB=clinica.db
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/clinica

# Generate independent secret values for each environment.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
COOKIE_SECURE=false
FLASK_DEBUG=0
INITIAL_ADMIN_PASSWORD=replace-before-initializing-a-new-SQLite-database